# Copy to .env for local use (do NOT commit .env)
# On Render: Dashboard → service → Environment (not Streamlit Cloud Secrets).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_DEMO_MODE=true

ANOMALY_CONTAMINATION=0.05

# Gemini (optional) — Insights / AI Assistant
# Required env name: GEMINI_API_KEY
# Default model: gemini-3.6-flash
# Retired aliases (gemini-2.0-flash, gemini-flash-latest, gemini-1.5-flash, gemini-pro)
# are remapped in code. 404s are shown in the UI (Test Gemini) — not swallowed.
GEMINI_API_KEY=
# Optional Autodesk APS CAD twin — add after Render deploy; app re-reads at runtime.
# APS_CLIENT_ID=
# APS_CLIENT_SECRET=
# APS_MODEL_URN=   # optional; or generate on CAD Twin: choose file → Translate to SVF / get URN
# APS app APIs: Model Derivative + Data Management. Token also needs data:write/create and bucket:create/read.

