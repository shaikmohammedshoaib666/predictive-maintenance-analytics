# Copy to .env for local use (do NOT commit .env)
# On Render: Dashboard → service → Environment (not Streamlit Cloud Secrets).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_DEMO_MODE=true

ANOMALY_CONTAMINATION=0.05

# Gemini (optional) — Insights / AI Assistant
# Required env name: GEMINI_API_KEY
# Default model: gemini-3.6-flash
# Retired aliases (gemini-2.0-flash, gemini-flash-latest, gemini-1.5-flash, gemini-pro)
# are remapped in code. 404s are shown in the UI (Test Gemini) — not swallowed.
GEMINI_API_KEY=
# Optional Autodesk APS CAD twin — add after Render deploy; app re-reads at runtime.
# APS_CLIENT_ID=
# APS_CLIENT_SECRET=
# APS_MODEL_URN=   # optional override; CAD Twin also saves last working URN per pack to data/cad_urns.json
# (that file is gitignored; copy data/cad_urns.example.json). Survives close-tab while the service is up;
# Render free-tier disk is wiped on redeploy — set APS_MODEL_URN to keep the model across deploys.
# APS app APIs: Model Derivative + Data Management. Token also needs data:write/create and bucket:create/read.

# Optional CAD region map seed (JSON string or path). Same honesty as APS_MODEL_URN:
# data/cad_region_map.json is gitignored and Render disk resets on redeploy — export JSON
# from CAD Twin, or set CAD_MAP_JSON so a map can be seeded on boot.
# CAD_MAP_JSON=

# Live Connect MQTT. 127.0.0.1 on Render is the Render box, not the hangar.
# MQTT_BROKER=127.0.0.1
# MQTT_PORT=1883
# MQTT_TOPIC=pdm/sensors/#
# MQTT_STALE_SECONDS=30
# APP_REVISION=   # optional; Render sets RENDER_GIT_COMMIT

